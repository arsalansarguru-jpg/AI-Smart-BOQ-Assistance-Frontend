# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: Supabase dashboard -> Project Settings -> API

# Base URL only — do NOT add /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# FastAPI backend (local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Vercel): server-side URL for /api/backend proxy (preferred)
# API_URL=https://your-service.up.railway.app
# Optional mirror for health display in the browser:
# NEXT_PUBLIC_API_URL=https://your-service.up.railway.app
