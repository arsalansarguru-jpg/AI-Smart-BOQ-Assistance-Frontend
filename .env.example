# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: Supabase dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# FastAPI backend (local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Vercel): set to your Render/Railway URL, e.g.
# NEXT_PUBLIC_API_URL=https://boq-automation-api.onrender.com
